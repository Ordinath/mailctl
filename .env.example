# IMAP Configuration (for reading emails)
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASS=password
IMAP_TLS=true

# SMTP Configuration (for sending emails)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_TLS=true

# Optional: Default "From" address for outgoing mail
# If not set, falls back to SMTP_USER
MAIL_FROM="Display Name <user@example.com>"

# Optional: Config directory (default: ~/.config/mailctl)
# MAILCTL_CONFIG_DIR=~/.config/mailctl
